# Paperless URL (no trailing slash)
PAPERLESS_URL=http://127.0.0.1:8000

# Paperless API token — create in the Paperless UI:
#   Settings → API Tokens → "Create token"
PAPERLESS_TOKEN=replace-me

# Bearer token clients must present.
# Generate with: openssl rand -hex 32
PAPERLESS_MCP_TOKEN=replace-me

# Network bind
PAPERLESS_MCP_HOST=0.0.0.0
PAPERLESS_MCP_PORT=8770
PAPERLESS_MCP_PATH=/mcp

# Set to 1 to disable update_document and upload_document
PAPERLESS_READ_ONLY=0
